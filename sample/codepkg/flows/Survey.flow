<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>49.0</apiVersion>
    <decisions>
        <name>When_to_Start</name>
        <label>When to Start</label>
        <locationX>336</locationX>
        <locationY>68</locationY>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>When_To_Start_Flow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Customer_Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Org_Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Cuisines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Drink</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Food_Categorys</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Food_Survey</targetReference>
            </connector>
            <label>When To Start Flow</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>Cuisine</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Cuisine__c</picklistField>
        <picklistObject>Food_Choice__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>Drinks</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Drink__c</picklistField>
        <picklistObject>Food_Choice__c</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>FoodCategory</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Food_Category__c</picklistField>
        <picklistObject>Food_Choice__c</picklistObject>
    </dynamicChoiceSets>
    <interviewLabel>Survey {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Survey</label>
    <processType>Flow</processType>
    <recordCreates>
        <name>Food_Survey</name>
        <label>Food Survey</label>
        <locationX>356</locationX>
        <locationY>189</locationY>
        <inputAssignments>
            <field>Cuisine__c</field>
            <value>
                <elementReference>Cuisines</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Drink__c</field>
            <value>
                <elementReference>Drink</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Food_Category__c</field>
            <value>
                <elementReference>Food_Categorys</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>Customer_Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Organization_Name__c</field>
            <value>
                <elementReference>Org_Name</elementReference>
            </value>
        </inputAssignments>
        <object>Food_Choice__c</object>
    </recordCreates>
    <screens>
        <name>Food_Surveys</name>
        <label>Food Survey</label>
        <locationX>134</locationX>
        <locationY>65</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>When_to_Start</targetReference>
        </connector>
        <fields>
            <name>Org_Name</name>
            <dataType>String</dataType>
            <fieldText>Organization Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Customer_Name</name>
            <dataType>String</dataType>
            <fieldText>Customer Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Drink</name>
            <choiceReferences>Drinks</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Drink</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Cuisines</name>
            <choiceReferences>Cuisine</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Cuisine</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Food_Categorys</name>
            <choiceReferences>FoodCategory</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Food Category</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <startElementReference>Food_Surveys</startElementReference>
    <status>Active</status>
    <textTemplates>
        <description>Customer Name</description>
        <name>Name</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>{!$GlobalConstant.EmptyString}</text>
    </textTemplates>
    <textTemplates>
        <description>OrgName</description>
        <name>OrgName</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>{!$GlobalConstant.EmptyString}</text>
    </textTemplates>
</Flow>
