    <fields>
        <fullName>Conference__c</fullName>
        <externalId>false</externalId>
        <label>Conference</label>
        <referenceTo>Conference__c</referenceTo>
        <relationshipLabel>Passes</relationshipLabel>
        <relationshipName>Passes</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>DiscountAmount__c</fullName>
        <externalId>false</externalId>
        <formula>Conference__r.Price__c  *  Discount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>DiscountAmount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Discount__c</fullName>
        <externalId>false</externalId>
        <label>Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Organization_Name__c</fullName>
        <externalId>false</externalId>
        <label>Organization Name</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
