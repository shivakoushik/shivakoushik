    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>full</fullName>
        <active>true</active>
        <errorConditionFormula>Conference__r.Total_Registrations__c  &lt;=   Conference__r.Completed_registrations__c</errorConditionFormula>
